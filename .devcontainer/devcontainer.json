{
  "name": "macos-style-desktop",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-22.04",

  "hostRequirements": {
    "cpus": 4,
    "memory": "8gb"
  },

  "postCreateCommand": "bash .devcontainer/setup.sh",
  "postStartCommand": "bash .devcontainer/start-desktop.sh",

  "forwardPorts": [6080],
  "portsAttributes": {
    "6080": {
      "label": "Desktop (noVNC)",
      "onAutoForward": "openBrowser"
    }
  }
}
